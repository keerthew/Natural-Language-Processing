        "# Install compatible libraries\n",
        "!pip install -q transformers sentencepiece sacremoses\n",
        "\n",
        "# Import libraries\n",
        "from transformers import MarianMTModel, MarianTokenizer\n",
        "\n",
        "# Model name: English → French\n",
        "model_name = \"Helsinki-NLP/opus-mt-en-fr\"\n",
        "\n",
        "# Load tokenizer\n",
        "tokenizer = MarianTokenizer.from_pretrained(model_name)\n",
        "\n",
        "# Load translation model\n",
        "model = MarianMTModel.from_pretrained(model_name)\n",
        "\n",
        "# Get English text from user\n",
        "english_text = input(\"Enter English text: \")\n",
        "\n",
        "# Convert English text into tokens\n",
        "inputs = tokenizer(\n",
        "    english_text,\n",
        "    return_tensors=\"pt\",\n",
        "    padding=True\n",
        ")\n",
        "\n",
        "# Generate French translation\n",
        "translated = model.generate(\n",
        "    **inputs,\n",
        "    max_length=100\n",
        ")\n",
        "\n",
        "# Convert tokens back into text\n",
        "french_text = tokenizer.decode(\n",
        "    translated[0],\n",
        "    skip_special_tokens=True\n",
        ")\n",
        "\n",
        "# Display results\n",
        "print(\"\\nEnglish:\", english_text)\n",
        "print(\"French:\", french_text)"
      ],
